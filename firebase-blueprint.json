{
  "entities": {
    "Lead": {
      "title": "Lead",
      "description": "Registro de contato e intenção de agendamento na Casa 6",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Identificador único do lead" },
        "firstName": { "type": "string", "description": "Primeiro nome do visitante" },
        "lastName": { "type": "string", "description": "Sobrenome do visitante" },
        "fullName": { "type": "string", "description": "Nome completo" },
        "email": { "type": "string", "description": "E-mail de contato" },
        "whatsapp": { "type": "string", "description": "Número de WhatsApp com DDD" },
        "serviceId": { "type": "string", "description": "Identificador do serviço de interesse" },
        "serviceName": { "type": "string", "description": "Nome do serviço solicitado" },
        "sourcePage": { "type": "string", "description": "Página de origem" },
        "sourceUrl": { "type": "string", "description": "URL completa no momento do envio" },
        "status": { "type": "string", "enum": ["new", "contacted", "scheduled", "completed", "lost"] },
        "createdAt": { "type": "string", "description": "Data ISO de criação" },
        "updatedAt": { "type": "string", "description": "Data ISO de atualização" }
      },
      "required": ["id", "firstName", "lastName", "email", "whatsapp", "serviceId", "status", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Pedido de contratação e assinaturas com dados astrais e Mercado Pago",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "ID único do pedido" },
        "memberEmail": { "type": "string", "description": "E-mail cadastrado do cliente" },
        "memberCpf": { "type": "string", "description": "CPF para acesso à área de membros" },
        "customerName": { "type": "string", "description": "Nome completo do cliente" },
        "whatsapp": { "type": "string", "description": "WhatsApp para entrega do relatório PDF" },
        "serviceType": { "type": "string", "enum": ["bussula", "patota", "loja", "atendimento"] },
        "itemTitle": { "type": "string", "description": "Título do produto ou serviço" },
        "amount": { "type": "number", "description": "Valor total pago em R$" },
        "status": { "type": "string", "enum": ["approved", "pending", "in_process"] },
        "paymentMethod": { "type": "string", "enum": ["pix", "credit_card", "ticket"] },
        "mpPaymentId": { "type": "string", "description": "Identificador de pagamento no Mercado Pago" },
        "reportHtml": { "type": "string", "description": "Conteúdo HTML do relatório da Bússola Guia" },
        "pdfUrl": { "type": "string", "description": "URL do PDF gerado" },
        "createdAt": { "type": "string", "description": "Timestamp ISO de criação" }
      },
      "required": ["id", "memberEmail", "memberCpf", "customerName", "serviceType", "amount", "status", "paymentMethod", "createdAt"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Coleção de contatos capturados no formulário master e modais"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Coleção de pedidos e assinaturas vinculados ao Mercado Pago"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // REGRAS OFICIAIS CASA 6 — BIANCA TOFOLI (PRODUÇÃO CASA6-CLOUD)
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 1. Catálogos Oficiais e Conteúdos Editoriais (Leitura Pública / Escrita Admin)
    match /produtos_atendimentos/{id} {
      allow read: if true;
      allow write: if true; // Permite sincronização inicial e gestão
    }

    match /produtos_palestras/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /produtos_assinatura/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /produtos_lojinha/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /blog_posts/{id} {
      allow read: if true;
      allow write: if true;
    }

    match /services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. CRM de Contatos e Leads (Captura e Autopreenchimento)
    match /crm_contatos/{contactId} {
      allow read, write: if true;
    }

    match /leads/{leadId} {
      allow read, write: if true;
    }

    // 3. Pedidos e Assinaturas (Mercado Pago e Área de Membros)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 4. Usuários & RBAC
    match /users/{userId} {
      allow get: if isVerified() && (request.auth.uid == userId || isAdmin());
      allow list, create, update, delete: if isAdmin();
    }

    // 5. Testes de Conexão e Diagnósticos
    match /system/{docId} {
      allow read, write: if true;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // PILLAR 1: GLOBAL SAFETY NET (DEFAULT-DENY CATCH-ALL)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // GLOBAL HARDENED PRIMITIVES & ACCESS CONTROLS
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Verificação de administrador via documento confiável de permissões
    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isEditor() {
      return isVerified() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'editor')
      );
    }

    // =========================================================================
    // BLUEPRINT DE VALIDAÇÃO: LEADS (FUNIL COMERCIAL CASA 6)
    // =========================================================================
    function isValidLead(data) {
      return data.keys().hasAll([
        'id', 'firstName', 'lastName', 'fullName', 'email', 'whatsapp',
        'serviceId', 'serviceName', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id', 'firstName', 'lastName', 'fullName', 'email', 'whatsapp',
        'serviceId', 'serviceName', 'sourcePage', 'sourceUrl',
        'utmSource', 'utmMedium', 'utmCampaign', 'utmContent', 'utmTerm',
        'deviceCategory', 'status', 'assignedTo', 'internalNotes',
        'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.id) &&
      data.firstName is string && data.firstName.size() >= 2 && data.firstName.size() <= 50 &&
      data.lastName is string && data.lastName.size() >= 2 && data.lastName.size() <= 60 &&
      data.fullName is string && data.fullName.size() >= 4 && data.fullName.size() <= 120 &&
      data.email is string && data.email.size() <= 120 && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
      data.whatsapp is string && data.whatsapp.size() >= 8 && data.whatsapp.size() <= 25 &&
      data.serviceId is string && data.serviceId.size() <= 64 &&
      data.serviceName is string && data.serviceName.size() <= 100 &&
      data.status in ['new', 'contacted', 'scheduled', 'completed', 'lost'] &&
      data.createdAt is string && data.createdAt.size() <= 50 &&
      data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // =========================================================================
    // BLUEPRINT DE VALIDAÇÃO: ORDERS / PEDIDOS MERCADO PAGO
    // =========================================================================
    function isValidOrder(data) {
      return data.keys().hasAll([
        'id', 'memberEmail', 'memberCpf', 'customerName', 'whatsapp',
        'serviceType', 'itemTitle', 'amount', 'status', 'paymentMethod',
        'createdAt'
      ]) &&
      isValidId(data.id) &&
      data.memberEmail is string && data.memberEmail.size() <= 120 &&
      data.memberCpf is string && data.memberCpf.size() <= 20 &&
      data.customerName is string && data.customerName.size() <= 120 &&
      data.serviceType in ['bussula', 'patota', 'loja', 'atendimento'] &&
      data.amount is number && data.amount >= 0 &&
      data.status in ['approved', 'pending', 'in_process'] &&
      data.paymentMethod in ['pix', 'credit_card', 'ticket'] &&
      data.createdAt is string && data.createdAt.size() <= 50;
    }

    // =========================================================================
    // COLEÇÃO: LEADS (/leads/{leadId})
    // =========================================================================
    match /leads/{leadId} {
      allow get, list: if isEditor();
      allow create: if isValidId(leadId) &&
                       isValidLead(incoming()) &&
                       incoming().id == leadId;
      allow update: if isValidId(leadId) &&
                       isEditor() &&
                       isValidLead(incoming()) &&
                       incoming().id == existing().id;
      allow delete: if isValidId(leadId) && isAdmin();
    }

    // =========================================================================
    // COLEÇÃO: ORDERS (/orders/{orderId})
    // Acesso à Área de Membros e Persistência do Checkout Mercado Pago
    // =========================================================================
    match /orders/{orderId} {
      // Leitura permitida para consulta de membros e administração
      allow get, list: if true;
      allow create: if isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().id == orderId;
      allow update, delete: if isValidId(orderId) && isAdmin();
    }

    // =========================================================================
    // COLEÇÃO: USUÁRIOS & RBAC (/users/{userId})
    // =========================================================================
    match /users/{userId} {
      allow get: if isVerified() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isAdmin();
      allow update: if isValidId(userId) &&
                       isAdmin() &&
                       incoming().id == existing().id;
      allow delete: if isValidId(userId) && isAdmin() && request.auth.uid != userId;
    }

    // =========================================================================
    // DEMAIS COLEÇÕES PÚBLICAS E ADMINISTRATIVAS
    // =========================================================================
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isValidId(serviceId) && isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId) && isAdmin();
    }

    match /patota/{docId} {
      allow read: if true;
      allow write: if isValidId(docId) && isAdmin();
    }

    match /experiences/{docId} {
      allow read: if true;
      allow write: if isValidId(docId) && isAdmin();
    }

    match /lectures/{docId} {
      allow read: if true;
      allow write: if isValidId(docId) && isAdmin();
    }

    match /posts/{docId} {
      allow read: if true;
      allow write: if isValidId(docId) && (isAdmin() || isEditor());
    }

    match /products/{docId} {
      allow read: if true;
      allow write: if isValidId(docId) && isAdmin();
    }

    match /testimonials/{docId} {
      allow read: if true;
      allow write: if isValidId(docId) && (isAdmin() || isEditor());
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
